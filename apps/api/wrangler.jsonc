{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bobo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The SPA and the API share one origin: static assets are served without invoking the
  // Worker (free and fast); only /api/* runs Worker code.
  "assets": {
    "directory": "../web/dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bobo-db",
      // Placeholder: the deploy workflow creates bobo-db if needed and fills in its id.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // Auth endpoint limits (src/rate-limit.ts). namespace_id must be unique in the account.
  "ratelimits": [
    {
      "name": "AUTH_EMAIL_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 },
    },
    {
      "name": "AUTH_IP_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  // To send email with Cloudflare Email Service (Workers Paid plan), add:
  //   "send_email": [{ "name": "EMAIL" }]
  // On the free plan, set the RESEND_API_KEY secret instead. Both need EMAIL_FROM.
  "observability": { "enabled": true },
}
