{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bobo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The SPA and the API share one origin: static assets are served without invoking the
  // Worker (free and fast); only /api/* runs Worker code.
  "assets": {
    "directory": "../web/dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bobo-db",
      // Replace with the id from `wrangler d1 create bobo-db` before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true },
}
