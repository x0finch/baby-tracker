{
  "name": "@bobo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "pnpm --filter @bobo/web build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply bobo-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply bobo-db --remote",
    "codegen": "wrangler types --env-interface Bindings",
    "typecheck": "tsc && tsc -p test"
  },
  "dependencies": {
    "@better-auth/passkey": "catalog:",
    "@bobo/shared": "workspace:*",
    "@tanstack/ai": "^0.69.0",
    "@tanstack/ai-openai": "^0.30.0",
    "better-auth": "catalog:",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "miniflare": "^4.20260730.0",
    "wrangler": "^4.149.0"
  }
}
