{
  "name": "@bobo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "pnpm --filter @bobo/web build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply bobo-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply bobo-db --remote",
    "typecheck": "tsc && tsc -p test"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.7",
    "@bobo/shared": "workspace:*",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "miniflare": "^4.20260730.0",
    "wrangler": "^4.149.0"
  }
}
